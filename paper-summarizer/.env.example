# Copy to .env (gitignored):  cp .env.example .env
# Never commit real keys. In Colab, the same names go in Secrets (🔑 sidebar).

# ---------------------------------------------------------------------------
# Mode switch: LLM_BASE_URL alone chooses offline vs online.
# The mock accepts any key and model name, so the other values can stay as your real ones.
# ---------------------------------------------------------------------------
LLM_BASE_URL=http://mock-llm:8000/v1          # offline: local mock, no cost
# LLM_BASE_URL=https://openrouter.ai/api/v1   # online: OpenRouter (what the course uses)
# LLM_BASE_URL=http://gateway:4000/v1         # online via the local LiteLLM proxy (make up)

LLM_API_KEY=sk-mock-local                     # OpenRouter: your sk-or-... key
LLM_MODEL=mock-llm                            # OpenRouter: one model or a comma-separated list, e.g.
#   nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
#   (re-read on every call: change it any time; a busy or capped model is skipped for the next)
LLM_FALLBACK_MODEL=mock-llm-fallback          # optional; OpenRouter e.g. nvidia/nemotron-3-super-120b-a12b:free
EMBED_MODEL=mock-embed                        # from Day 2; OpenRouter e.g. nvidia/nemotron-3-embed-1b:free
# LLM_MAX_TOKENS_PARAM=max_completion_tokens  # if your model rejects max_tokens (see tools/check_gateway.py)

# Host port for mock-llm (8000 is often taken, e.g. by VPN clients)
MOCK_PORT=8100

# ---------------------------------------------------------------------------
# LiteLLM gateway (core service from Day 4) with Postgres (keys, budgets, spend) and Redis (rate limits, cache)
# Defaults forward to mock-llm, so the whole stack can be rehearsed offline.
# ---------------------------------------------------------------------------
# A PLACEHOLDER, generated for this file: make your own with `echo sk-$(openssl rand -hex 32)`.
# The proxy refuses to start with an unset, empty or publicly known master key (e.g. sk-1234).
LITELLM_MASTER_KEY=sk-34fa8087d393540798e7c3b476db1c9160934db91b75e062f7400ff201618ae9
# Encrypts secrets stored in Postgres; set once and never change it (changing the master key is then safe).
LITELLM_SALT_KEY=salt-0dda81be3360aeb5a537936802b6a615
LITELLM_DB_PASSWORD=litellm-local                # Postgres password for the gateway (local volume only)
PROVIDER_BASE_URL=http://mock-llm:8000/v1
PROVIDER_API_KEY=sk-mock-local
PROVIDER_MODEL=openai/mock-llm                # LiteLLM form: <provider>/<model>
# OpenRouter behind the gateway: PROVIDER_BASE_URL=https://openrouter.ai/api/v1, PROVIDER_API_KEY=sk-or-...,
# PROVIDER_MODEL=openai/nvidia/nemotron-3-ultra-550b-a55b:free (the openai/ prefix = "OpenAI-compatible API")
PROVIDER_FALLBACK_MODEL=openai/mock-llm-fallback
PROVIDER_EMBED_MODEL=openai/mock-embed
GATEWAY_PORT=4000

# ---------------------------------------------------------------------------
# Day 4 api service (GATEWAY_MODE=proxy: every model call goes through the gateway with the user's virtual key)
# ---------------------------------------------------------------------------
API_PORT=8200                                 # host port for the api (8000 is often taken)
PROMPT_VERSION=v1                             # the agent prompt the api serves (prompts/agent_<version>.txt)
# PRICE_IN_PER_M=0.15                         # USD per 1M tokens, for the cost fields (empty = workshop prices)
# PRICE_OUT_PER_M=0.60

# ---------------------------------------------------------------------------
# Corporate networks (optional): proxies for image builds and outbound calls
# ---------------------------------------------------------------------------
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,mock-llm,gateway,api,postgres,redis
